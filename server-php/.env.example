# ---------------------------------------------------------------------------
# Appointments API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# This product's own name, sent to other AICOUNTLY products so they suppress
# their calls back to us mid-request. Leave as-is.
APP_PRODUCT_KEY=appointments

# --- Database ---------------------------------------------------------------
# Appointments' OWN PostgreSQL database. It holds appointment-owned data only:
# services, bookings, policies, forms, the waitlist. It is NEVER pointed at
# Calendar, Contacts, Pay or CRM — those are read through their HTTP APIs.
#
# cPanel PostgreSQL: if 127.0.0.1 fails pg_hba, try a Unix socket with
# DB_HOST=/tmp and leave DB_SSLMODE unset. Only set DB_SSLMODE=require if
# `psql "sslmode=require"` works on that host.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aicountly_appointments
DB_USER=
DB_PASS=
# DB_SCHEMA=public

# After setting these, apply the schema:
#   php <document root>/api/bin/migrate.php
# and confirm with:
#   curl https://appointments.aicountly.com/api/health

# --- AICOUNTLY portal -------------------------------------------------------
# Leave unset unless you are pointing at a non-standard portal —
# my.aicountly.com serves BOTH production and sandbox. (sandbox.aicountly.com
# is a login redirect only; it does not serve seskey or validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===========================================================================
# AICOUNTLY CALENDAR — REQUIRED
#
# Calendar owns every calendar and every event in the fleet. Appointments does
# not keep a copy of anybody's diary: it reads availability and writes bookings
# through the Calendar API, live, on the request that needs it.
#
# WITHOUT THIS, APPOINTMENTS CANNOT COMPUTE AVAILABILITY OR TAKE A BOOKING.
# /api/health reports usable:false until it is set.
#
# The key must also be listed on the Calendar host as
#   CALENDAR_SERVICE_KEYS=appointments:<the same key>
# Generate one with: openssl rand -hex 32
# ===========================================================================
CALENDAR_SERVICE_KEY=
# Derived from this host's own name when unset (sandbox talks to sandbox).
# CALENDAR_API_BASE=https://calendar.aicountly.com

# ===========================================================================
# AICOUNTLY CONTACTS — client identity
#
# Contacts owns client names, numbers and addresses. Appointments keeps a
# contact reference and appointment-specific preferences, never a second
# contact master. On by default; turn it off only where Contacts is not
# deployed, in which case the booking drawer falls back to searching clients
# who have booked here before.
# ===========================================================================
APPOINTMENTS_CONTACTS_ENABLED=1
# CONTACTS_API_BASE=https://contacts.aicountly.com

# ===========================================================================
# AICOUNTLY MANAGE — companies, branches and people
#
# Derived from this host's own name when unset. Manage is what the tenant
# check asks whether a session may open a company, so an unreachable Manage
# denies access rather than granting it.
# ===========================================================================
# MANAGE_API_BASE=https://manage.aicountly.com

# ===========================================================================
# AI — Appointments' own insight engine
#
# The PROMPTS AND RULES live in this product. The PROVIDER KEY lives in
# Console (console.aicountly.org) and is fetched per request, held in memory,
# and never written to disk here. There is deliberately no provider key in
# this file.
#
# With these unset, dashboards still produce insights — from this product's
# own rules, labelled "rule-based" rather than AI.
# ===========================================================================
APPOINTMENTS_AI_ENABLED=1
# CONSOLE_API_URL=https://console.aicountly.org/api
# CONSOLE_SERVICE_KEY=

# ===========================================================================
# Features Appointments owns outright. On unless turned off.
# ===========================================================================
APPOINTMENTS_WAITLIST_ENABLED=1
APPOINTMENTS_PUBLIC_BOOKING_ENABLED=1

# ===========================================================================
# Integrations that are still being built elsewhere in the fleet.
#
# Each has a complete client and a complete contract in this codebase. Turning
# one on needs its flag AND its key — a flag alone is read as OFF, because an
# administrator who meant to finish and did not should find out in Integrations
# rather than in front of a client mid-booking.
#
# Until then every surface that depends on one says so plainly. Nothing is
# faked and nothing reports as connected.
# ===========================================================================

# Aicountly Pay — deposits and prepayments. Appointments sets the policy; Pay
# collects the money. While this is off, services that require a deposit
# cannot be booked online.
# APPOINTMENTS_PAY_ENABLED=1
# PAY_SERVICE_KEY=
# PAY_API_BASE=https://pay.aicountly.com

# Aicountly Receptionist — the voice front desk. Receptionist calls
# Appointments to find and book slots; this is the return leg that reports its
# contribution.
# APPOINTMENTS_RECEPTIONIST_ENABLED=1
# RECEPTIONIST_SERVICE_KEY=
# RECEPTIONIST_API_BASE=https://receptionist.aicountly.com

# Aicountly Connect — video rooms for online appointments. In-person, phone and
# external-video appointments work without it.
# APPOINTMENTS_CONNECT_ENABLED=1
# CONNECT_SERVICE_KEY=
# CONNECT_API_BASE=https://connect.aicountly.com

# Aicountly CRM — relationship context shown next to an appointment.
# APPOINTMENTS_CRM_ENABLED=1
# CRM_SERVICE_KEY=
# CRM_API_BASE=https://crm.aicountly.com

# Aicountly Billing — invoices for completed appointments.
# APPOINTMENTS_BILLING_ENABLED=1
# BILLING_SERVICE_KEY=
# BILLING_API_BASE=https://billing.aicountly.com

# Messaging — WhatsApp, SMS and email delivery. Appointments owns the reminder
# RULES and TIMERS; this delivers them. While it is off, reminders are still
# computed and scheduled and are marked "not sent" — never shown as delivered.
# APPOINTMENTS_MESSAGING_ENABLED=1
# MESSAGING_SERVICE_KEY=
# MESSAGING_API_BASE=https://messaging.aicountly.com

# ===========================================================================
# Service keys other AICOUNTLY products present when they call Appointments.
#
# Receptionist is the one that matters: a caller on the phone has no session
# here, and the person who answered is not the practitioner whose diary is
# being filled. The key proves which product is calling, and the booking source
# on the dashboards is decided by it — never by the request body.
#
# Format: comma-separated product:key pairs. Generate with: openssl rand -hex 32
# ===========================================================================
# SERVICE_KEYS=receptionist:CHANGE_ME_64_HEX,crm:CHANGE_ME_64_HEX
